PORT=3002
NODE_ENV=development

# Dejar vacío para deshabilitar autenticación
API_KEY=
ALLOWED_ORIGINS=*

# Caché en milisegundos (900000 = 15 minutos)
CACHE_TTL=900000

# Contrato público de https://99envios.app/cotizar
# La sucursal 21119 es la que trae hardcodeada su frontend. No pide login.
ENVIOS99_INTEGRATION_URL=https://integration1.99envios.app
ENVIOS99_SUCURSAL_ID=21119
ENVIOS99_TIMEOUT_MS=15000

LOG_LEVEL=info
